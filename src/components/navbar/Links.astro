                    </summary>
                    <div class="bg-base-200/50 flex flex-col pb-2">
                        
                        <span class="px-10 pt-3 pb-1 text-[10px] font-bold text-gray-400 uppercase tracking-wider">Souvenir Pernikahan</span>
                        <a href="/category/souvenir?sub=tumbler" class="flex items-center gap-3 py-2 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:coffee" class="w-4 h-4 text-[#233876]" /> Tumbler</a>
