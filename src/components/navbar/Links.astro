                        <a href="/category/undangan?sub=custom" class="flex items-center gap-3 py-2.5 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:pen-tool" class="w-4 h-4 text-[#233876]" /> Undangan Custom</a>
                        <a href="/category/undangan?sub=blangko" class="flex items-center gap-3 py-2.5 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:file" class="w-4 h-4 text-[#233876]" /> Undangan Blangko</a>
                    </div>
                </details>

                <!-- ACCORDION SOUVENIR -->
                <details class="group border-b border-base-200">
                    <summary class="py-3 px-6 text-sm font-semibold text-base-content hover:bg-base-200 cursor-pointer flex justify-between items-center list-none">
