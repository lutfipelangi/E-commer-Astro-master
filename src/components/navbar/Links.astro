                        <a href="/category/souvenir?sub=poster" class="flex items-center gap-3 py-2 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:image" class="w-4 h-4 text-[#233876]" /> Poster</a>

                        <span class="px-10 pt-4 pb-1 text-[10px] font-bold text-gray-400 uppercase tracking-wider">Souvenir Seminar</span>
                        <a href="/category/souvenir?sub=kaos" class="flex items-center gap-3 py-2 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:shirt" class="w-4 h-4 text-[#233876]" /> Kaos</a>
