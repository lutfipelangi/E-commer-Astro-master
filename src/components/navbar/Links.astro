---
import { Icon } from "astro-icon/components";
---

<div class="bg-base-100 border-b border-base-200 relative z-40 transition-colors duration-300">
    
    <!-- ========================================== -->
    <!-- TAMPILAN MOBILE (HANYA MUNCUL DI HP)       -->
    <!-- ========================================== -->
    <div class="sm:hidden flex flex-col w-full">
        <!-- Tombol Buka Menu di HP -->
        <div class="flex items-center justify-between h-12 px-4 border-b border-base-200">
            <button id="mobile-links-toggle" class="flex items-center gap-2 font-semibold text-base-content">
                <Icon name="lucide:menu" class="w-5 h-5" /> Menu Kategori
            </button>
            <a href="/contact" class="text-sm font-semibold text-primary">Hubungi Kami</a>
        </div>

        <!-- Isi Menu HP (Sembunyi, muncul saat diklik) -->
        <div id="mobile-links-menu" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out bg-base-100 overflow-hidden">
            <div class="min-h-0 flex flex-col max-h-[75vh] overflow-y-auto custom-scrollbar">
                <a href="/" class="py-3 px-6 text-sm font-semibold text-base-content hover:bg-base-200 border-b border-base-200 transition-colors">Home</a>
                
                <!-- ACCORDION PERCETAKAN -->
                <details class="group border-b border-base-200">
                    <summary class="py-3 px-6 text-sm font-semibold text-base-content hover:bg-base-200 cursor-pointer flex justify-between items-center list-none">
