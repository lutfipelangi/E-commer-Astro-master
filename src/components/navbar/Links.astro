                        <a href="/category/percetakan?sub=packaging-rokok" class="flex items-center gap-3 py-2 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:box" class="w-4 h-4 text-[#233876]" /> Packaging Rokok</a>
                        <a href="/category/percetakan?sub=packaging-skincare" class="flex items-center gap-3 py-2 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:sparkles" class="w-4 h-4 text-[#233876]" /> Packaging Skincare</a>
                        <a href="/category/percetakan?sub=packaging-obat" class="flex items-center gap-3 py-2 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:pill" class="w-4 h-4 text-[#233876]" /> Packaging Obat</a>
