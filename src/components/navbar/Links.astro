                        <a href="/category/percetakan?sub=cetak-buku" class="flex items-center gap-3 py-2 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:book-open" class="w-4 h-4 text-[#233876]" /> Cetak Buku</a>
                        <a href="/category/percetakan?sub=company-profile" class="flex items-center gap-3 py-2 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:building" class="w-4 h-4 text-[#233876]" /> Cetak Company Profile</a>
                        <a href="/category/percetakan?sub=majalah" class="flex items-center gap-3 py-2 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:newspaper" class="w-4 h-4 text-[#233876]" /> Cetak Majalah</a>
                        <a href="/category/percetakan?sub=buku-tabungan" class="flex items-center gap-3 py-2 pl-10 pr-6 text-sm text-base-content/80 hover:text-primary"><Icon name="lucide:wallet" class="w-4 h-4 text-[#233876]" /> Buku Tabungan</a>
