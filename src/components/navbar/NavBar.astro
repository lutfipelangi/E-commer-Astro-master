<script>
    // 1. Deklarasikan variabel navbar dengan menangkap ID dari HTML
    const navbar = document.getElementById("main-navbar");
    // 2. Deklarasikan lastScrollY
    let lastScrollY = window.scrollY;

    window.addEventListener("scroll", () => {
        if (!navbar) return;

        const currentScrollY = window.scrollY;

        // If we are at the top, always show
        if (currentScrollY <= 0) {
            navbar.classList.remove("navbar-hidden");
            lastScrollY = currentScrollY;
            return;
        }

        // Detect scroll direction
        if (currentScrollY > lastScrollY) {
            // Scroll down -> Hide
            navbar.classList.add("navbar-hidden");
        } else {
            // Scroll up -> Show
            navbar.classList.remove("navbar-hidden");
        }

        lastScrollY = currentScrollY;
    });

    // --- Logika Toggle Dark Mode (Versi Kapsul) ---
    const themeToggleBtn = document.getElementById('theme-toggle');
    const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
    const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
    const themeText = document.getElementById('theme-text');

    if (themeToggleBtn) {
        // Cek state awal
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark' || localStorage.getItem('color-theme') === 'dark';
        
        if (isDark) {
            themeToggleLightIcon?.classList.remove('hidden');
            themeToggleDarkIcon?.classList.add('hidden');
            if (themeText) themeText.textContent = 'Dark';
        } else {
            themeToggleDarkIcon?.classList.remove('hidden');
            themeToggleLightIcon?.classList.add('hidden');
            if (themeText) themeText.textContent = 'Light';
        }

        // Aksi saat diklik
        themeToggleBtn.addEventListener('click', function() {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            
            if (currentTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'light');
                localStorage.setItem('color-theme', 'light');
                
                themeToggleLightIcon?.classList.add('hidden');
                themeToggleDarkIcon?.classList.remove('hidden');
                if (themeText) themeText.textContent = 'Light';
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('color-theme', 'dark');
                
                themeToggleDarkIcon?.classList.add('hidden');
                themeToggleLightIcon?.classList.remove('hidden');
                if (themeText) themeText.textContent = 'Dark';
            }
        });
    }
</script>