---
import Layout from "../layouts/Layout.astro";
import CheckoutForm from "../components/checkout/CheckoutForm.astro";
import CheckoutSummary from "../components/checkout/CheckoutSummary.astro";
import CheckoutTicket from "../components/checkout/CheckoutTicket.astro";
import { Icon } from "astro-icon/components";
---

<Layout>
    <div class="bg-slate-50 min-h-screen py-12 md:py-20 px-4">
        <div class="max-w-7xl mx-auto">
            <!-- Breadcrumbs / Back Link -->
            <a
                href="/"
                class="inline-flex items-center gap-2 text-slate-400 hover:text-slate-950 font-bold text-[10px] uppercase tracking-widest transition-colors mb-8 group"
            >
                <Icon
                    name="lucide:arrow-left"
                    class="w-4 h-4 group-hover:-translate-x-1 transition-transform"
                />
                Back to Store
            </a>

            <div
                class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-12 items-start"
            >
                <!-- Left: Form -->
                <div class="space-y-12">
                    <div class="space-y-4">
                        <span
                            class="text-primary font-black uppercase text-xs tracking-[0.3em] italic"
                            >Secure Checkout</span
                        >
                        <h1
                            class="text-4xl md:text-5xl font-black text-slate-950 uppercase tracking-tighter italic"
                        >
                            Finalize Your Order
                        </h1>
                        <p class="text-slate-500 font-medium">
                            Please provide your details below to complete your
                            premium purchase.
                        </p>
                    </div>

                    <CheckoutForm />
                </div>

                <!-- Right: Summary -->
                <CheckoutSummary />
            </div>
        </div>
    </div>

    <CheckoutTicket />
</Layout>

<<script>
    import { completePurchase, cartItems, totalPrice } from "../store/cartStore";

    // Kita tunggu sampai halaman selesai dimuat
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("checkout-form") as HTMLFormElement;
        
        if (form) {
            form.addEventListener("submit", (e) => {
                e.preventDefault();
                
                // Ambil data
                const formData = new FormData(form);
                const nama = formData.get('firstName') || 'Pelanggan';
                const alamat = formData.get('address') || '-';
                const kota = formData.get('city') || '-';
                
                // Susun pesan WA
                const pesan = `Halo Kios Pelangi, saya ${nama}.%0ASaya ingin konfirmasi pesanan.%0AAlamat: ${alamat}, ${kota}.`;
                
                // Ganti 6281234567890 dengan nomor WA Bos
                const waUrl = `https://wa.me/6281336642266?text=${pesan}`;
                
                // Buka WA
                window.open(waUrl, '_blank');
                
                // Hapus keranjang belanja setelah checkout (opsional)
                // completePurchase(); 
            });
        }
    });
</script>
