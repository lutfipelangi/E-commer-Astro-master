---
import ClientMarquee from '../components/home/ClientMarquee.astro';
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import CategoryHome from "../components/home/CategoryHome.astro";
import FeaturedProducts from "../components/home/FeaturedProducts.astro";
---

<Layout>
    <Hero />
    <ClientMarquee /> 
    <CategoryHome />
    <FeaturedProducts />

    <!-- ================= SECTION ALUR PEMESANAN ================= -->
    <section class="py-16 bg-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Judul Section -->
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#233876] mb-4">Alur Pemesanan di Kios Pelangi</h2>
          <p class="text-gray-500 text-base md:text-lg">
            Tidak perlu repot, cukup 4 langkah mudah untuk mewujudkan hasil cetak berkualitas untuk kebutuhan Anda.
          </p>
        </div>

        <!-- Grid 4 Langkah -->
        <div class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-6">
          
          <!-- Garis Penghubung (Hanya muncul di Desktop) -->
          <div class="hidden lg:block absolute top-8 left-[12%] right-[12%] h-0.5 bg-gray-200 -z-10"></div>

          <!-- Langkah 1 -->
          <div class="relative flex flex-col items-center text-center group">
            <div class="relative w-16 h-16 rounded-full bg-white border-2 border-[#233876] flex items-center justify-center mb-6 group-hover:bg-blue-50 transition-colors shadow-sm">
              <!-- Badge Angka -->
              <div class="absolute -top-1 -right-1 w-6 h-6 bg-[#233876] text-white rounded-full flex items-center justify-center text-xs font-bold border-2 border-white">1</div>
              <!-- Ikon Chat -->
              <svg class="w-7 h-7 text-[#233876]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-3">Konsultasi WA</h3>
            <p class="text-sm text-gray-500 leading-relaxed px-2">
              Hubungi admin kami untuk diskusi spesifikasi bahan, jumlah cetak, dan dapatkan estimasi harga terbaik.
            </p>
          </div>

          <!-- Langkah 2 -->
          <div class="relative flex flex-col items-center text-center group">
            <div class="relative w-16 h-16 rounded-full bg-white border-2 border-[#233876] flex items-center justify-center mb-6 group-hover:bg-blue-50 transition-colors shadow-sm">
              <div class="absolute -top-1 -right-1 w-6 h-6 bg-[#233876] text-white rounded-full flex items-center justify-center text-xs font-bold border-2 border-white">2</div>
              <!-- Ikon Dokumen -->
              <svg class="w-7 h-7 text-[#233876]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-3">Kirim Desain & Proofing</h3>
            <p class="text-sm text-gray-500 leading-relaxed px-2">
              Kirim file siap cetak Anda. Kami akan melakukan pengecekan dan membuat *dummy* untuk persetujuan Anda.
            </p>
          </div>

          <!-- Langkah 3 -->
          <div class="relative flex flex-col items-center text-center group">
            <div class="relative w-16 h-16 rounded-full bg-white border-2 border-[#233876] flex items-center justify-center mb-6 group-hover:bg-blue-50 transition-colors shadow-sm">
              <div class="absolute -top-1 -right-1 w-6 h-6 bg-[#233876] text-white rounded-full flex items-center justify-center text-xs font-bold border-2 border-white">3</div>
              <!-- Ikon Centang / QC -->
              <svg class="w-7 h-7 text-[#233876]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-3">Produksi & QC</h3>
            <p class="text-sm text-gray-500 leading-relaxed px-2">
              Setelah DP masuk & desain ACC, proses cetak massal dimulai dan dilanjutkan dengan Quality Control ketat.
            </p>
          </div>

          <!-- Langkah 4 -->
          <div class="relative flex flex-col items-center text-center group">
            <div class="relative w-16 h-16 rounded-full bg-white border-2 border-[#233876] flex items-center justify-center mb-6 group-hover:bg-blue-50 transition-colors shadow-sm">
              <div class="absolute -top-1 -right-1 w-6 h-6 bg-[#233876] text-white rounded-full flex items-center justify-center text-xs font-bold border-2 border-white">4</div>
              <!-- Ikon Truk Pengiriman -->
              <svg class="w-7 h-7 text-[#233876]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-3">Pengiriman Aman</h3>
            <p class="text-sm text-gray-500 leading-relaxed px-2">
              Pelunasan diselesaikan, dan hasil cetak siap dikirim dengan aman ke alamat Anda atau diambil di toko.
            </p>
          </div>

        </div>
      </div>
    </section>
    <!-- ================= END SECTION ALUR PEMESANAN ================= -->

    <!-- ================= SECTION PENAWARAN HARGA ================= -->
    <section class="bg-[#233876] py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto bg-[#1a2957] rounded-3xl overflow-hidden shadow-2xl border border-blue-900 flex flex-col lg:flex-row">
        
        <!-- BAGIAN KIRI: TEKS PROMOSI -->
        <div class="w-full lg:w-1/2 p-10 sm:p-14 flex flex-col justify-center">
          
          <!-- Badge Kecil -->
          <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white px-3 py-1.5 rounded-md text-xs font-bold w-fit mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-400"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            HARGA TERBAIK
          </div>

          <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white leading-tight mb-6">
            Penawaran Harga <br>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-200 to-cyan-300">Murah & Transparan</span>
          </h2>
          
          <p class="text-blue-100 text-base sm:text-lg leading-relaxed mb-6">
            Sebagai perusahaan percetakan terpercaya, kami memberikan penawaran harga yang transparan, kompetitif, dan paling murah di kelasnya. Harga menyesuaikan kuantitas, jenis kertas, ukuran, dan spesifikasi finishing.
          </p>

          <!-- List Keunggulan -->
          <ul class="text-sm text-blue-200 space-y-3 mt-2">
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Tanpa Biaya Tersembunyi
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Respon Cepat & Ramah
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Kualitas Cetak Terjamin
            </li>
          </ul>
        </div>

        <!-- BAGIAN KANAN: FORMULIR -->
        <div class="w-full lg:w-1/2 p-4 sm:p-8 flex items-center">
          <div class="bg-white w-full rounded-2xl p-6 sm:p-8 shadow-inner">
            
            <form id="quote-form" class="flex flex-col gap-4">
              
              <!-- Nama Perusahaan -->
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Nama Perusahaan / Instansi</label>
                <input type="text" id="quote_nama" placeholder="Masukkan nama perusahaan" required
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:border-[#233876] focus:ring-1 focus:ring-[#233876] text-sm text-gray-800" />
              </div>

              <!-- Kebutuhan Cetak -->
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Kebutuhan Cetak (Produk)</label>
                <input type="text" id="quote_produk" placeholder="Contoh: Brosur, Kemasan, ID Card" required
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:border-[#233876] focus:ring-1 focus:ring-[#233876] text-sm text-gray-800" />
              </div>

              <!-- Grid untuk Qty dan WA -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Estimasi Qty</label>
                  <input type="number" id="quote_qty" placeholder="Jumlah cetak" required
                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:border-[#233876] focus:ring-1 focus:ring-[#233876] text-sm text-gray-800" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Nomor WA Anda</label>
                  <input type="tel" id="quote_wa" placeholder="Contoh: 08123xxx" required
                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:border-[#233876] focus:ring-1 focus:ring-[#233876] text-sm text-gray-800" />
                </div>
              </div>

              <!-- Tombol Kirim -->
              <button type="submit" 
                class="mt-2 w-full bg-[#233876] hover:bg-[#1a2957] text-white font-bold rounded-lg py-3 px-4 flex justify-center items-center gap-2 transition-all shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Kirim Pesan
              </button>
            </form>

          </div>
        </div>

      </div>
    </section>

    <!-- SCRIPT UNTUK MENGIRIM KE WHATSAPP -->
    <script>
      document.getElementById('quote-form')?.addEventListener('submit', function(e) {
        e.preventDefault();

        const nama = document.getElementById('quote_nama').value;
        const produk = document.getElementById('quote_produk').value;
        const qty = document.getElementById('quote_qty').value;
        const waPelanggan = document.getElementById('quote_wa').value;

        // Ganti dengan nomor WhatsApp Admin Anda
        const noAdmin = '62816262734'; 

        let pesan = `Halo Admin Kios Pelangi,%0A%0A`;
        pesan += `Saya ingin meminta penawaran harga:%0A`;
        pesan += `*Nama/Instansi:* ${nama}%0A`;
        pesan += `*Kebutuhan:* ${produk}%0A`;
        pesan += `*Estimasi Qty:* ${qty}%0A`;
        pesan += `*No. WA Saya:* ${waPelanggan}%0A%0A`;
        pesan += `Mohon info harga dan estimasi pengerjaannya. Terima kasih.`;

        window.open(`https://wa.me/${noAdmin}?text=${pesan}`, '_blank');
      });
    </script>
    <!-- ================= END SECTION PENAWARAN HARGA ================= -->

</Layout>