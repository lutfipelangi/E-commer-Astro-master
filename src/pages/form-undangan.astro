---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Formulir Pemesanan - Kios Pelangi">
  <div class="min-h-screen bg-gray-50 py-12 px-4 flex items-center justify-center font-sans">
    
    <div class="max-w-3xl w-full bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
      
      <!-- HEADER & PROGRESS BAR -->
      <div class="bg-[#233876] px-8 py-6 text-white">
        <h1 class="text-2xl font-bold mb-6">Formulir Pemesanan</h1>
        <div class="flex items-center justify-between text-sm font-medium text-blue-200">
          <div class="flex flex-col items-center gap-2">
            <span id="ind-1" class="w-8 h-8 flex items-center justify-center rounded-full bg-white text-[#233876] font-bold">1</span>
            <span id="text-ind-1" class="text-white">Layanan</span>
          </div>
          <div class="flex-grow border-t border-blue-800 mx-2"></div>
          <div class="flex flex-col items-center gap-2">
            <span id="ind-2" class="w-8 h-8 flex items-center justify-center rounded-full bg-blue-800 text-blue-300 font-bold">2</span>
            <span id="text-ind-2" class="text-blue-300">Detail</span>
          </div>
          <div class="flex-grow border-t border-blue-800 mx-2"></div>
          <div class="flex flex-col items-center gap-2">
            <span id="ind-3" class="w-8 h-8 flex items-center justify-center rounded-full bg-blue-800 text-blue-300 font-bold">3</span>
            <span id="text-ind-3" class="text-blue-300">Selesai</span>
          </div>
        </div>
      </div>

      <!-- FORM CONTAINER -->
      <div class="p-8">
        <form id="order-form">
          
          <!-- ================= LANGKAH 1: LAYANAN & KONTAK ================= -->
          <div id="step-1" class="flex flex-col gap-6 animate-fade-in">
            <div>
              <h2 class="text-xl font-bold text-gray-900 mb-1">Apa yang ingin Anda pesan?</h2>
              <p class="text-gray-500 text-sm mb-4">Pilih salah satu layanan kami di bawah ini.</p>
              
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <label class="cursor-pointer">
                  <input type="radio" name="layanan" value="undangan" class="peer sr-only">
                  <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-[#233876] peer-checked:bg-blue-50 hover:border-blue-300 transition-all">
                    <Icon name="lucide:mail" class="w-8 h-8 mx-auto mb-2 text-[#233876]" />
                    <span class="font-semibold text-gray-800">Undangan</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="layanan" value="souvenir" class="peer sr-only">
                  <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-[#233876] peer-checked:bg-blue-50 hover:border-blue-300 transition-all">
                    <Icon name="lucide:gift" class="w-8 h-8 mx-auto mb-2 text-[#233876]" />
                    <span class="font-semibold text-gray-800">Souvenir</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="layanan" value="percetakan" class="peer sr-only">
                  <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-[#233876] peer-checked:bg-blue-50 hover:border-blue-300 transition-all">
                    <Icon name="lucide:printer" class="w-8 h-8 mx-auto mb-2 text-[#233876]" />
                    <span class="font-semibold text-gray-800">Percetakan</span>
                  </div>
                </label>
              </div>
            </div>

            <hr class="border-gray-100">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nama Pemesan</label>
                <input type="text" id="nama_pemesan" name="nama_pemesan" placeholder="Nama Lengkap" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]" required />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nomor WhatsApp</label>
                <input type="tel" id="no_telp" name="no_whatsapp" placeholder="cth: 08123456789" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]" required />
              </div>
            </div>

            <button type="button" id="btn-next-1" class="mt-4 w-full bg-[#233876] hover:bg-[#1a2957] text-white font-bold rounded-xl py-3.5 transition-all shadow-md">
              Lanjut ke Detail Pesanan &rarr;
            </button>
          </div>

          <!-- ================= LANGKAH 2: DETAIL PESANAN ================= -->
          <div id="step-2" class="hidden flex-col gap-6 max-h-[60vh] overflow-y-auto pr-2 custom-scrollbar">
            
            <!-- DETAIL UNDANGAN -->
            <div id="detail-undangan" class="hidden flex-col gap-8">
              <div>
                <h3 class="text-lg font-bold text-[#233876] mb-4 border-b pb-2">Data Calon Mempelai</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nama Lengkap Mempelai Wanita</label>
                    <input type="text" name="nama_mempelai_wanita" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Nama Lengkap" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nama Lengkap Mempelai Pria</label>
                    <input type="text" name="nama_mempelai_pria" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Nama Lengkap" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nama Panggilan Wanita</label>
                    <input type="text" name="panggilan_wanita" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Nama Panggilan" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nama Panggilan Pria</label>
                    <input type="text" name="panggilan_pria" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Nama Panggilan" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nama Ayah & Ibu Wanita</label>
                    <input type="text" name="orangtua_wanita" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Bapak ... & Ibu ..." />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nama Ayah & Ibu Pria</label>
                    <input type="text" name="orangtua_pria" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Bapak ... & Ibu ..." />
                  </div>
                </div>
              </div>

              <div>
                <h3 class="text-lg font-bold text-[#233876] mb-4 border-b pb-2">Acara Akad Nikah / Pemberkatan</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Hari, Tanggal, Tahun</label>
                    <input type="date" name="tanggal_akad" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Jam</label>
                    <input type="time" name="jam_akad" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" />
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-800 mb-1.5">Alamat Lengkap</label>
                  <textarea rows="2" name="alamat_akad" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Nama Gedung, Jalan, Kota..."></textarea>
                </div>
              </div>

              <div>
                <h3 class="text-lg font-bold text-[#233876] mb-4 border-b pb-2">Acara Resepsi</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Hari, Tanggal, Tahun</label>
                    <input type="date" name="tanggal_resepsi" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Jam</label>
                    <input type="time" name="jam_resepsi" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" />
                  </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Lokasi Gedung</label>
                    <input type="text" name="lokasi_resepsi" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Nama Gedung / Rumah" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Alamat Lengkap</label>
                    <input type="text" name="alamat_resepsi" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Jalan, Kota..." />
                  </div>
                </div>
              </div>

              <div>
                <h3 class="text-lg font-bold text-[#233876] mb-4 border-b pb-2">Acara Tambahan / Ngunduh Mantu <span class="text-sm font-normal text-gray-500">(Jika ada)</span></h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Hari, Tanggal, Tahun</label>
                    <input type="date" name="tanggal_ngunduh" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Jam</label>
                    <input type="time" name="jam_ngunduh" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" />
                  </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Lokasi Gedung</label>
                    <input type="text" name="lokasi_ngunduh" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Nama Gedung" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Alamat Lengkap</label>
                    <input type="text" name="alamat_ngunduh" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="Jalan, Kota..." />
                  </div>
                </div>
              </div>

              <div>
                <h3 class="text-lg font-bold text-[#233876] mb-4 border-b pb-2">Hiburan & Foto</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Hiburan (Opsional)</label>
                    <input type="text" name="hiburan" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="cth: Band Akustik, DJ" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Upload Foto Prewedding</label>
                    <input type="file" id="foto_prewedding" name="foto" accept="image/*" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876] bg-gray-50 text-sm" />
                    <p class="text-xs text-gray-500 mt-1">Format: JPG/PNG. Maks 5MB.</p>
                  </div>
                </div>
              </div>

              <div>
                <h3 class="text-lg font-bold text-[#233876] mb-4 border-b pb-2">Detail Pesanan Undangan</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Jumlah Pesanan (Pcs)</label>
                    <input type="number" name="jumlah_undangan" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="cth: 500" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Model Undangan</label>
                    <select name="model_undangan" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]">
                      <option value="hardcover">Hardcover Premium</option>
                      <option value="softcover">Softcover Elegan</option>
                      <option value="digital">Digital / E-Invitation</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">Harga Undangan (Per Pcs)</label>
                    <input type="number" name="harga_undangan" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="cth: 5000" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1.5">DP / Uang Muka (Rp)</label>
                    <input type="number" name="dp_undangan" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-[#233876]" placeholder="cth: 500000" />
                  </div>
                </div>
              </div>
            </div>

            <!-- DETAIL SOUVENIR -->
            <div id="detail-souvenir" class="hidden flex-col gap-4">
              <h2 class="text-xl font-bold text-gray-900 mb-1">Detail Souvenir</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nama Souvenir</label>
                  <input type="text" name="nama_souvenir" placeholder="cth: Tumbler Custom, Totebag" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-800 mb-1.5">Jumlah Pesanan</label>
                  <input type="number" name="jumlah_souvenir" placeholder="cth: 100" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-800 mb-1.5">Keterangan / Desain Khusus</label>
                <textarea rows="3" name="keterangan_souvenir" placeholder="Jelaskan detail desain atau kebutuhan khusus..." class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]"></textarea>
              </div>
            </div>

            <!-- DETAIL PERCETAKAN -->
            <div id="detail-percetakan" class="hidden flex-col gap-4">
              <h2 class="text-xl font-bold text-gray-900 mb-1">Detail Percetakan</h2>
              <div>
                <label class="block text-sm font-semibold text-gray-800 mb-1.5">Jumlah Pesanan (Lembar/Pcs)</label>
                <input type="number" name="jumlah_percetakan" placeholder="cth: 500" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-800 mb-1.5">Keterangan (Jenis Kertas, Ukuran, dll)</label>
                <textarea rows="3" name="keterangan_percetakan" placeholder="cth: Cetak brosur A5, kertas Art Paper 150gsm..." class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]"></textarea>
              </div>
            </div>

          </div>

          <!-- Tombol Navigasi Step 2 -->
          <div id="step-2-buttons" class="hidden gap-3 mt-6 border-t pt-6">
            <button type="button" id="btn-prev-2" class="w-1/3 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-xl py-3.5 transition-all">
              &larr; Kembali
            </button>
            <button type="button" id="btn-next-2" class="w-2/3 bg-[#233876] hover:bg-[#1a2957] text-white font-bold rounded-xl py-3.5 transition-all shadow-md">
              Lanjut ke Konfirmasi &rarr;
            </button>
          </div>

          <!-- ================= LANGKAH 3: KONFIRMASI ================= -->
          <div id="step-3" class="hidden flex-col gap-6">
            
            <div class="text-center py-4">
              <p class="text-gray-700 font-medium">Pastikan semua data sudah benar.</p>
            </div>

            <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 text-center mt-2">
              <p class="text-[#233876] font-bold mb-2">TERIMA KASIH TELAH MEMERCAYAKAN MOMEN SPESIAL ANDA KEPADA KAMI.</p>
              <p class="text-sm text-gray-600">Kami siap membantu mewujudkan undangan pernikahan yang berkesan dan istimewa.</p>
            </div>

            <div class="flex flex-col gap-4 mt-4">
              <div class="flex gap-3">
                <button type="button" id="btn-prev-3" class="w-1/3 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-xl py-3.5 transition-all">
                  &larr; Kembali
                </button>
                <button type="submit" id="btn-submit-final" class="w-2/3 bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold rounded-xl py-3.5 transition-all shadow-[0_4px_14px_0_rgba(37,211,102,0.39)]">
                  Kirim via WhatsApp
                </button>
              </div>
              
              <button type="button" id="btn-logout-form" class="w-full bg-red-50 hover:bg-red-100 text-red-600 font-bold rounded-xl py-3.5 transition-all border border-red-200 mt-2">
                Keluar dari Akun
              </button>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  document.addEventListener('DOMContentLoaded', () => {
    
    // --- FUNGSI PINDAH LANGKAH ---
    const btnNext1 = document.getElementById('btn-next-1');
    if (btnNext1) {
      btnNext1.addEventListener('click', () => {
        const nama = document.getElementById('nama_pemesan').value;
        const telp = document.getElementById('no_telp').value;
        const layanan = document.querySelector('input[name="layanan"]:checked');

        if (!layanan) return alert("Silakan pilih salah satu layanan terlebih dahulu.");
        if (nama.trim() === "" || telp.trim() === "") return alert("Mohon isi Nama Pemesan dan Nomor WhatsApp Anda.");

        document.getElementById('step-1').classList.add('hidden');
        document.getElementById('step-1').classList.remove('flex');
        
        document.getElementById('step-2').classList.remove('hidden');
        document.getElementById('step-2').classList.add('flex');
        document.getElementById('step-2-buttons').classList.remove('hidden');
        document.getElementById('step-2-buttons').classList.add('flex');

        const targetDetail = document.getElementById(`detail-${layanan.value}`);
        document.getElementById('detail-undangan').classList.add('hidden');
        document.getElementById('detail-souvenir').classList.add('hidden');
        document.getElementById('detail-percetakan').classList.add('hidden');
        if(targetDetail) {
          targetDetail.classList.remove('hidden');
          targetDetail.classList.add('flex');
        }

        // Ubah Indikator
        document.getElementById('ind-1').className = "w-8 h-8 flex items-center justify-center rounded-full bg-green-400 text-white font-bold";
        document.getElementById('ind-1').innerHTML = "✓";
        document.getElementById('ind-2').className = "w-8 h-8 flex items-center justify-center rounded-full bg-white text-[#233876] font-bold";
        document.getElementById('text-ind-2').className = "text-white font-bold";
      });
    }

    document.getElementById('btn-prev-2')?.addEventListener('click', () => {
      document.getElementById('step-2').classList.add('hidden');
      document.getElementById('step-2').classList.remove('flex');
      document.getElementById('step-2-buttons').classList.add('hidden');
      document.getElementById('step-2-buttons').classList.remove('flex');
      document.getElementById('step-1').classList.remove('hidden');
      document.getElementById('step-1').classList.add('flex');
    });

    document.getElementById('btn-next-2')?.addEventListener('click', () => {
      document.getElementById('step-2').classList.add('hidden');
      document.getElementById('step-2').classList.remove('flex');
      document.getElementById('step-2-buttons').classList.add('hidden');
      document.getElementById('step-2-buttons').classList.remove('flex');
      document.getElementById('step-3').classList.remove('hidden');
      document.getElementById('step-3').classList.add('flex');

      // Ubah Indikator
      document.getElementById('ind-2').className = "w-8 h-8 flex items-center justify-center rounded-full bg-green-400 text-white font-bold";
      document.getElementById('ind-2').innerHTML = "✓";
      document.getElementById('ind-3').className = "w-8 h-8 flex items-center justify-center rounded-full bg-white text-[#233876] font-bold";
      document.getElementById('text-ind-3').className = "text-white font-bold";
    });

    document.getElementById('btn-prev-3')?.addEventListener('click', () => {
      document.getElementById('step-3').classList.add('hidden');
      document.getElementById('step-3').classList.remove('flex');
      document.getElementById('step-2').classList.remove('hidden');
      document.getElementById('step-2').classList.add('flex');
      document.getElementById('step-2-buttons').classList.remove('hidden');
      document.getElementById('step-2-buttons').classList.add('flex');
    });


    // --- LOGIKA SIMPAN KE SUPABASE & WHATSAPP ---
    document.getElementById('order-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const nama = document.getElementById('nama_pemesan').value;
      const telp = document.getElementById('no_telp').value;
      const layanan = document.querySelector('input[name="layanan"]:checked').value;

      // Kumpulkan semua data (sekarang name="" sudah ada di HTML)
      const formData = new FormData(e.target);
      const detailPesanan = {};
      
      formData.forEach((value, key) => {
        if (key !== 'foto' && value !== "") {
          detailPesanan[key] = value;
        }
      });

      // Tombol berubah jadi loading
      const submitBtn = document.getElementById('btn-submit-final');
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = "Menyimpan Data...";
      submitBtn.disabled = true;

      try {
        let fotoUrl = null;
        const fileInput = document.getElementById('foto_prewedding');
        
        // 1. Upload Foto (Jika ada)
        if (fileInput && fileInput.files.length > 0) {
          const file = fileInput.files[0];
          const fileExt = file.name.split('.').pop();
          const fileName = `${Date.now()}-${Math.random().toString(36).substring(2)}.${fileExt}`;

          const { error: uploadError } = await supabase.storage
            .from('foto-prewedding')
            .upload(fileName, file);

          if (uploadError) throw new Error("Gagal upload foto: " + uploadError.message);

          const { data: urlData } = supabase.storage
            .from('foto-prewedding')
            .getPublicUrl(fileName);
          
          fotoUrl = urlData.publicUrl;
        }

        // 2. Simpan Teks ke Tabel 'pesanan'
        const { error: dbError } = await supabase
          .from('pesanan')
          .insert([{
            nama_pemesan: nama,
            no_whatsapp: telp,
            layanan: layanan,
            detail_pesanan: detailPesanan,
            foto_url: fotoUrl
          }]);

        if (dbError) throw new Error("Gagal simpan ke database: " + dbError.message);

        // 3. Buka WhatsApp
        let pesanWA = `Halo Admin Kios Pelangi,%0A%0A`;
        pesanWA += `Saya *${nama}* (${telp}) ingin memesan layanan *${layanan.toUpperCase()}*.%0A`;
        pesanWA += `Data saya sudah masuk ke sistem website. Mohon segera diproses ya. Terima kasih.`;
        
        window.open(`https://wa.me/62816262734?text=${pesanWA}`, '_blank');

        // Kembalikan tombol
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;

      } catch (error) {
        console.error(error);
        alert(error.message);
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      }
    });


    // --- LOGIKA LOGOUT ---
    document.getElementById('btn-logout-form')?.addEventListener('click', async () => {
      const confirmLogout = confirm("Apakah Anda yakin ingin keluar?");
      if (confirmLogout) {
        await supabase.auth.signOut();
        window.location.replace('/login');
      }
    });

  });
</script>

