---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Form Undangan - Kios Pelangi">
  <div class="min-h-screen bg-gray-50 py-12 px-4">
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <h1 class="text-2xl font-bold text-gray-900 mb-6">Formulir Pesanan Undangan</h1>
      <p class="text-gray-500 mb-8">Silakan lengkapi data diri Anda untuk proses pembuatan undangan.</p>

      <form class="flex flex-col gap-5">
        <div>
          <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nama Lengkap</label>
          <input type="text" placeholder="Masukkan nama lengkap" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]" required />
        </div>
        
        <div>
          <label class="block text-sm font-semibold text-gray-800 mb-1.5">Nomor Telepon / WhatsApp</label>
          <input type="tel" placeholder="cth: 08123456789" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]" required />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-800 mb-1.5">Alamat Lengkap</label>
          <textarea rows="3" placeholder="Masukkan alamat lengkap pengiriman" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]" required></textarea>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-800 mb-1.5">Jenis Undangan</label>
          <select class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-[#233876]" required>
            <option value="">Pilih jenis undangan...</option>
            <option value="pernikahan">Undangan Pernikahan</option>
            <option value="khitanan">Undangan Khitanan</option>
            <option value="aqiqah">Undangan Aqiqah</option>
          </select>
        </div>

        <button type="submit" class="w-full bg-[#233876] hover:bg-[#1a2957] text-white font-bold rounded-xl py-3.5 mt-4 transition-all shadow-md">
          Simpan Data
        </button>
      </form>
    </div>
  </div>
</Layout>