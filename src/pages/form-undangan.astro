---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Admin Dashboard - Kios Pelangi">
  <div class="min-h-screen bg-gray-50 py-10 px-4 font-sans">
    <div class="max-w-7xl mx-auto">
      
      <!-- Header -->
      <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Data Customer</h1>
          <p class="text-gray-500 mt-1">Total Pesanan: <span id="total-pesanan" class="font-bold text-[#233876]">0</span></p>
        </div>
        <button id="btn-refresh" class="flex items-center gap-2 bg-[#233876] hover:bg-[#1a2957] text-white px-5 py-2.5 rounded-lg font-semibold transition-all shadow-md">
          <Icon name="lucide:refresh-cw" class="w-4 h-4" /> Refresh Data
        </button>
      </div>

      <!-- Tabel Pesanan -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-white border-b border-gray-200 text-xs font-bold text-gray-500 uppercase tracking-wider">
                <th class="px-6 py-4">No. Nota</th>
                <th class="px-6 py-4">Nama Customer</th>
                <th class="px-6 py-4">Tipe Order</th>
                <th class="px-6 py-4">Tgl Acara</th>
                <th class="px-6 py-4">Detail Pesanan</th>
                <th class="px-6 py-4 text-center">Posisi</th>
                <th class="px-6 py-4 text-center">Administrasi</th>
              </tr>
            </thead>
            <tbody id="table-body" class="divide-y divide-gray-100">
              <!-- Data akan diisi oleh JavaScript -->
              <tr>
                <td colspan="7" class="px-6 py-10 text-center text-gray-500">Memuat data...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  // Fungsi Format Rupiah
  const formatRp = (angka) => {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka || 0);
  };

  // Fungsi Utama Mengambil Data
  async function loadDataPesanan() {
    const tbody = document.getElementById('table-body');
    const totalEl = document.getElementById('total-pesanan');
    
    // Ambil data dari tabel 'pesanan'
    const { data: pesanan, error } = await supabase
      .from('pesanan')
      .select('*')
      .order('no_nota', { ascending: false });

    if (error) {
      console.error("Error fetching data:", error);
      tbody.innerHTML = `<tr><td colspan="7" class="text-center text-red-500 py-6">Gagal memuat data: ${error.message}</td></tr>`;
      return;
    }

    if (!pesanan || pesanan.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="text-center text-gray-500 py-6">Belum ada pesanan masuk.</td></tr>`;
      totalEl.textContent = "0";
      return;
    }

    // Update Total Pesanan di Header
    totalEl.textContent = pesanan.length.toString();

    // Kosongkan tabel
    tbody.innerHTML = '';

    // Looping setiap pesanan
    pesanan.forEach((order, index) => {
      
      // --- 1. HITUNG TOTAL HARGA & DP DARI KERANJANG (ARRAY) ---
      let totalHarga = 0;
      let totalDp = 0;
      
      // Pastikan detail_pesanan adalah array (jika string JSON, kita parse dulu)
      let items = [];
      try {
        items = typeof order.detail_pesanan === 'string' 
          ? JSON.parse(order.detail_pesanan) 
          : (order.detail_pesanan || []);
      } catch (e) {
        console.error("Gagal parse JSON", e);
      }

      if (Array.isArray(items)) {
        items.forEach(item => {
          const qty = parseInt(item.qty) || 0;
          const harga = parseInt(item.harga) || 0;
          const dp = parseInt(item.dp) || 0;
          totalHarga += (qty * harga);
          totalDp += dp;
        });
      }

      // --- 2. BUAT BARIS TABEL UTAMA ---
      const tr = document.createElement('tr');
      tr.className = "hover:bg-gray-50 transition-colors";
      tr.innerHTML = `
        <td class="px-6 py-4 font-bold text-gray-900">${order.no_nota}</td>
        <td class="px-6 py-4 font-medium text-gray-800">${order.nama_pemesan}</td>
        <td class="px-6 py-4 capitalize text-gray-600">${order.layanan}</td>
        <td class="px-6 py-4 text-gray-500">-</td>
        
        <!-- TOMBOL LIHAT DETAIL -->
        <td class="px-6 py-4">
          <button class="btn-detail flex items-center gap-1 text-sm text-blue-600 font-semibold hover:text-blue-800" data-target="detail-${index}">
            <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            Lihat Detail
          </button>
        </td>

        <!-- DROPDOWN POSISI -->
        <td class="px-6 py-4 text-center">
          <select class="border border-gray-300 text-gray-700 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 bg-gray-50">
            <option selected>Antri Desain</option>
            <option>Proses Desain</option>
            <option>Proses Cetak</option>
            <option>Proses Finishing</option>
            <option>Siap Ambil</option>
          </select>
        </td>

        <!-- BADGE DP WARNA ORANGE -->
        <td class="px-6 py-4 text-center">
          <span class="inline-flex items-center px-3 py-1.5 rounded-md text-xs font-bold bg-orange-400 text-white shadow-sm">
            DP: ${formatRp(totalDp)}
          </span>
        </td>
      `;
      tbody.appendChild(tr);

      // --- 3. BUAT BARIS DETAIL (Tersembunyi by default) ---
      const trDetail = document.createElement('tr');
      trDetail.id = `detail-${index}`;
      trDetail.className = "hidden bg-white border-b-2 border-gray-200";
      
      let detailHtml = `<td colspan="7" class="px-6 py-6">
                          <div class="bg-gray-50 p-5 rounded-xl border border-gray-200 shadow-inner">
                            <h4 class="font-bold text-[#233876] mb-4 border-b pb-2 text-lg">Rincian Item Pesanan:</h4>
                            <ul class="space-y-4">`;

      if (items.length > 0) {
        items.forEach((item) => {
          detailHtml += `
            <li class="pb-3 border-b border-gray-200 last:border-0 last:pb-0">
              <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
                <div class="md:col-span-2">
                  <p class="font-bold text-gray-900 text-base">${item.nama_item}</p>
                  <p class="text-sm text-gray-600">Jumlah: <span class="font-semibold text-gray-900">${item.qty}</span></p>
                  <p class="text-sm text-gray-600">Harga Satuan: <span class="font-semibold text-gray-900">${formatRp(item.harga)}</span></p>
                </div>
                <div class="md:col-span-2 md:text-right flex flex-col justify-center">
                  <p class="text-sm text-gray-600">Subtotal: <span class="font-bold text-green-600">${formatRp(item.qty * item.harga)}</span></p>
                  <p class="text-sm text-gray-600">DP Item Ini: <span class="font-bold text-orange-500">${formatRp(item.dp)}</span></p>
                </div>
              </div>
          `;

          // Tampilkan isi form detail (nama mempelai, keterangan, dll)
          if (item.detail_lengkap && Object.keys(item.detail_lengkap).length > 0) {
            detailHtml += `<div class="mt-3 p-3 bg-white rounded-lg border border-gray-200 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2 text-sm shadow-sm">`;
            for (const [key, value] of Object.entries(item.detail_lengkap)) {
              // Format label (misal: nama_souvenir -> Nama Souvenir)
              const label = key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
              detailHtml += `<div><span class="font-semibold text-gray-500">${label}:</span> <span class="text-gray-900 font-medium">${value}</span></div>`;
            }
            detailHtml += `</div>`;
          }

          detailHtml += `</li>`;
        });
      } else {
        detailHtml += `<li class="text-gray-500 italic">Tidak ada rincian item.</li>`;
      }

      detailHtml += `</ul></div></td>`;
      trDetail.innerHTML = detailHtml;
      tbody.appendChild(trDetail);
    });

    // --- 4. LOGIKA TOMBOL LIHAT DETAIL (TOGGLE) ---
    document.querySelectorAll('.btn-detail').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetId = btn.getAttribute('data-target');
        const targetRow = document.getElementById(targetId);
        const icon = btn.querySelector('svg');

        if (targetRow.classList.contains('hidden')) {
          targetRow.classList.remove('hidden');
          icon.classList.add('rotate-90'); // Putar ikon
        } else {
          targetRow.classList.add('hidden');
          icon.classList.remove('rotate-90');
        }
      });
    });
  }

  // Jalankan saat halaman dimuat
  document.addEventListener('DOMContentLoaded', () => {
    loadDataPesanan();
    
    // Tombol Refresh
    document.getElementById('btn-refresh')?.addEventListener('click', () => {
        loadDataPesanan();
    });
  });

</script>