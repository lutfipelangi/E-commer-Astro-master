---
// File ini tidak menggunakan script di bagian atas, melainkan di dalam <script type="module">
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cetak Nota - Kios Pelangi</title>
  <style>
    @media print {
      @page { size: A5 landscape; margin: 5mm; }
      body { background: white !important; margin: 0 !important; padding: 0 !important; }
      .no-print { display: none !important; }
      #nota-container { box-shadow: none !important; border-radius: 0 !important; padding: 0 !important; max-width: 100% !important; width: 100% !important; page-break-inside: avoid; }
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      .header { padding-bottom: 5px !important; margin-bottom: 10px !important; border-bottom-width: 2px !important; }
      .logo { width: 40px !important; height: 40px !important; }
      .company-name { font-size: 18px !important; margin-bottom: 0px !important; }
      .company-sub { font-size: 10px !important; line-height: 1.1 !important; }
      .header-right h2 { font-size: 18px !important; margin-bottom: 2px !important; }
      .header-right p { font-size: 10px !important; margin-bottom: 0px !important; }
      .client-info { margin-bottom: 10px !important; padding: 5px 10px !important; }
      .client-info h3 { font-size: 14px !important; margin-bottom: 0px !important; }
      .client-info p, .client-info span { font-size: 10px !important; }
      table.main-table { font-size: 10px !important; margin-bottom: 10px !important; }
      table.main-table th { padding: 4px 8px !important; font-size: 10px !important; }
      table.main-table td { padding: 4px 8px !important; }
      .item-name { font-size: 11px !important; }
      .item-desc { font-size: 9px !important; }
      .totals-wrapper { margin-top: 10px !important; margin-bottom: 15px !important; }
      .totals-table { width: 220px !important; font-size: 10px !important; }
      .totals-table td { padding: 4px 8px !important; }
      .totals-table .grand-total-row td { font-size: 12px !important; padding: 4px 8px !important; }
      .footer-signature-wrapper { margin-top: 15px !important; padding-top: 10px !important; }
      .footer { font-size: 9px !important; line-height: 1.2 !important; }
      .signature-space { height: 40px !important; }
    }
    body { background-color: #f3f4f6; margin: 0; font-family: Arial, sans-serif; }
  </style>
</head>
<body style="padding: 40px 20px; display: flex; justify-content: center; color: #333;">

  <div id="nota-container" style="background: #fff; width: 100%; max-width: 800px; padding: 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
    <div style="text-align: center; padding: 50px; color: #888;">Memuat data nota...</div>
  </div>

  <script type="module">
    import { supabase } from '../lib/supabase';

    document.addEventListener('DOMContentLoaded', async () => {
      const urlParams = new URLSearchParams(window.location.search);
      const id = urlParams.get('id');
      const container = document.getElementById('nota-container');

      if (!id) {
        container.innerHTML = "<h2 style='text-align:center; color:red;'>Error: ID Nota tidak ditemukan di URL.</h2>";
        return;
      }

      try {
        const { data: item, error } = await supabase.from('pesanan').select('*').eq('id', id).single();

        if (error || !item) {
          throw new Error("Data pesanan tidak ditemukan di database.");
        }

        const detail = item.detail_pesanan || {};
        
        const dateObj = new Date(item.created_at);
        const dateStr = dateObj.toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' });
        const timeStr = dateObj.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }).replace('.', ':') + ' WIB';
        
        const noNota = item.no_nota || `PW${String(item.id).substring(0, 6).toUpperCase()}`;

        // --- LOGIKA PARSING DATA (ARRAY BARU ATAU OBJECT LAMA) ---
        let items = [];
        
        if (Array.isArray(detail)) {
          items = detail.map(d => {
            let ket = '';
            if (d.layanan === 'souvenir' && d.detail_lengkap?.keterangan_souvenir) {
              ket = d.detail_lengkap.keterangan_souvenir;
            } else if (d.layanan === 'percetakan' && d.detail_lengkap?.keterangan_percetakan) {
              ket = d.detail_lengkap.keterangan_percetakan;
            }

            return {
              nama: d.nama_item || 'Item',
              harga: parseInt(d.harga) || 0,
              qty: parseInt(d.qty) || 0,
              dp: parseInt(d.dp) || 0,
              keterangan: ket 
            };
          });
        } else {
          if (item.layanan === 'souvenir') {
            items.push({ nama: detail.nama_souvenir ? `Souvenir: ${detail.nama_souvenir}` : 'Souvenir Custom', harga: parseInt(detail.harga_souvenir) || 0, qty: parseInt(detail.jumlah_souvenir) || 0, dp: parseInt(detail.dp_souvenir) || 0, keterangan: detail.keterangan_souvenir || '' });
          } else if (item.layanan === 'percetakan') {
            items.push({ nama: detail.nama_percetakan ? `Percetakan: ${detail.nama_percetakan}` : 'Layanan Percetakan', harga: parseInt(detail.harga_percetakan) || 0, qty: parseInt(detail.jumlah_percetakan) || 0, dp: parseInt(detail.dp_percetakan) || 0, keterangan: detail.keterangan_percetakan || '' });
          } else {
            items.push({ nama: `Undangan ${detail.model_undangan || ''}`, harga: parseInt(detail.harga_undangan) || 0, qty: parseInt(detail.jumlah_undangan) || 0, dp: parseInt(detail.dp_undangan) || 0, keterangan: '' });
          }
        }

        const formatRp = (angka) => "Rp " + angka.toLocaleString('id-ID');

        // --- RENDER TABEL ---
        let tableRows = '';
        let grandTotal = 0;
        let grandDp = 0;

        items.forEach(it => {
          const subtotal = it.harga * it.qty;
          grandTotal += subtotal;
          grandDp += it.dp;

          const keteranganHTML = it.keterangan ? `<div class="item-desc" style="font-size: 11px; color: #475569; margin-top: 4px; font-style: italic;">Ket: ${it.keterangan}</div>` : '';

          tableRows += `
            <tr>
              <td style="border: 1px solid #ccc; padding: 6px 8px;">
                <strong class="item-name" style="color: #233876; font-size: 13px;">${it.nama}</strong>
                ${keteranganHTML}
              </td>
              <td style="border: 1px solid #ccc; padding: 6px 8px; text-align: right; vertical-align: top;">${formatRp(it.harga)}</td>
              <td style="border: 1px solid #ccc; padding: 6px 8px; text-align: center; vertical-align: top;">${it.qty}</td>
              <td style="border: 1px solid #ccc; padding: 6px 8px; text-align: right; font-weight: bold; vertical-align: top;">${formatRp(subtotal)}</td>
            </tr>
          `;
        });

        const sisa = grandTotal - grandDp;

        // --- LOGIKA BARIS TOTAL ---
        let totalRowsHtml = `
          <tr>
            <td style="border: 1px solid #ccc; padding: 5px 8px; background: #f9f9f9; font-weight: bold; text-align: right;">Total Tagihan:</td>
            <td style="border: 1px solid #ccc; padding: 5px 8px; text-align: right; font-weight: bold;">${formatRp(grandTotal)}</td>
          </tr>
        `;

        if (grandDp > 0) {
            totalRowsHtml += `
              <tr>
                <td style="border: 1px solid #ccc; padding: 5px 8px; background: #f9f9f9; font-weight: bold; text-align: right; color: #059669;">Total DP Dibayar:</td>
                <td style="border: 1px solid #ccc; padding: 5px 8px; text-align: right; font-weight: bold; color: #059669;">- ${formatRp(grandDp)}</td>
              </tr>
            `;
        }
        
        totalRowsHtml += `
          <tr class="grand-total-row">
            <td style="border: 1px solid #ccc; padding: 6px 8px; background: #f9f9f9; font-weight: bold; text-align: right; font-size: 13px;">Sisa Tagihan:</td>
            <td style="border: 1px solid #ccc; padding: 6px 8px; text-align: right; font-weight: bold; color: #e11d48; font-size: 13px;">${formatRp(sisa)}</td>
          </tr>
        `;

        container.innerHTML = `
          <div class="header" style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #233876; padding-bottom: 15px; margin-bottom: 15px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <img src="/logo.png" alt="Logo" class="logo" style="width: 55px; height: 55px; object-fit: contain; border-radius: 6px;" onerror="this.style.display='none'">
              <div>
                <h1 class="company-name" style="font-size: 24px; color: #233876; margin: 0 0 3px 0; font-weight: 800;">Kios Pelangi</h1>
                <p class="company-sub" style="font-size: 11px; color: #666; margin: 0 0 2px 0;">www.kiospelangi.com | WA: 0816262734</p>
                <p class="company-sub" style="font-size: 11px; color: #666; margin: 0;">Percetakan | Undangan & Souvenir</p>
              </div>
            </div>
            <div class="header-right" style="text-align: right;">
              <h2 style="font-size: 22px; color: #111; margin: 0 0 5px 0; font-weight: bold; letter-spacing: 1px;">INVOICE</h2>
              <p style="font-size: 11px; color: #555; margin: 0 0 2px 0;"><strong>No:</strong> ${noNota}</p>
              <p style="font-size: 11px; color: #555; margin: 0;"><strong>Date:</strong> ${dateStr} | ${timeStr}</p>
            </div>
          </div>

          <div class="client-info" style="margin-bottom: 15px; background-color: #f8fafc; padding: 8px 12px; border-radius: 6px; border-left: 4px solid #233876;">
            <p style="font-size: 10px; color: #666; margin: 0 0 2px 0; font-weight: bold;">Kepada Yth Bapak/ Ibu/ Saudara/ i:</p>
            <h3 style="font-size: 16px; color: #111; margin: 0 0 2px 0;">${item.nama_pemesan}</h3>
            <p style="font-size: 11px; color: #475569; margin: 0;">${item.no_whatsapp}</p>
          </div>

          <table class="main-table" style="width: 100%; border-collapse: collapse; margin-bottom: 12px; font-size: 12px;">
            <thead>
              <tr>
                <th style="border: 1px solid #ccc; background-color: #233876; color: white; padding: 6px 8px; text-align: left;">Deskripsi Layanan</th>
                <th style="border: 1px solid #ccc; background-color: #233876; color: white; padding: 6px 8px; text-align: right; width: 100px;">Harga</th>
                <th style="border: 1px solid #ccc; background-color: #233876; color: white; padding: 6px 8px; text-align: center; width: 50px;">Qty</th>
                <th style="border: 1px solid #ccc; background-color: #233876; color: white; padding: 6px 8px; text-align: right; width: 120px;">Total</th>
              </tr>
            </thead>
            <tbody>
              ${tableRows}
            </tbody>
          </table>

          <!-- PEMBARUAN: Wrapper sejajar -->
          <div class="totals-wrapper" style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 15px; margin-bottom: 20px;">
            
            <!-- KOTAK INFO REKENING (DIPERKECIL & DIRAPATKAN) -->
            <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px 12px; width: 300px;">
              <p style="margin: 0 0 3px 0; font-size: 9px; font-weight: bold; color: #475569; text-transform: uppercase; letter-spacing: 0.5px;">Informasi Pembayaran</p>
              <p style="margin: 0 0 4px 0; font-size: 10px; color: #0f172a;">Silakan transfer ke:</p>
              
              <!-- BARIS SEJAJAR UNTUK BANK & REKENING -->
              <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #94a3b8; padding-bottom: 4px; margin-bottom: 4px;">
                <span style="font-size: 13px; font-weight: bold; color: #233876;">Bank BCA</span>
                <span style="font-size: 15px; font-weight: bold; color: #0f172a; letter-spacing: 0.5px;">64646465464</span>
              </div>
              
              <p style="margin: 0; font-size: 10px; color: #475569;">a.n. Eka Wati Sutrisno</p>
            </div>

            <!-- TABEL TOTAL TAGIHAN -->
            <table class="totals-table" style="width: 250px; border-collapse: collapse; font-size: 11px; margin: 0;">
              ${totalRowsHtml}
            </table>
          </div>

          <div class="footer-signature-wrapper" style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 20px; padding-top: 15px; border-top: 1px solid #eee;">
            
            <div class="footer" style="text-align: left; font-size: 9px; color: #666; max-width: 350px;">
              <p style="margin: 0 0 3px 0;">Terima kasih atas kepercayaan Anda kepada kami.</p>
              <p style="margin: 0;">Barang yang sudah dipesan tidak dapat dibatalkan.</p>
            </div>
            
            <!-- AREA TANDA TANGAN -->
            <div style="display: flex; gap: 60px; text-align: center; font-size: 11px;">
              <div style="min-width: 150px;">
                <p style="margin: 0 0 5px 0;">Hormat Kami,</p>
                <div class="signature-space" style="height: 60px;"></div>
                <p style="margin: 0; font-weight: bold; border-top: 1px solid #333; padding-top: 5px;">Moch Luthfie Mubtadi</p>
              </div>
              <div style="min-width: 150px;">
                <p style="margin: 0 0 5px 0;">Penerima,</p>
                <div class="signature-space" style="height: 60px;"></div>
                <p style="margin: 0; font-weight: bold; border-top: 1px solid #333; padding-top: 5px;">${item.nama_pemesan}</p>
              </div>
            </div>
            <!-- END TANDA TANGAN -->

          </div>
        `;
      } catch (err) {
        console.error(err);
        container.innerHTML = `
          <div style="text-align: center; padding: 40px;">
            <h2 style="color: #dc2626; margin-bottom: 10px;">Gagal Memuat Nota</h2>
            <p style="color: #475569;">${err.message || 'Terjadi kesalahan sistem.'}</p>
          </div>
        `;
      }
    });
  </script>

  <div class="no-print" style="margin-top: 20px; display: flex; justify-content: center; gap: 15px;">
    <button onclick="window.print()" style="background-color: #233876; color: white; padding: 12px 25px; border: none; border-radius: 6px; font-size: 16px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
      🖨️ Cetak Nota (Print)
    </button>
    <a href="/admin" style="background-color: #e2e8f0; color: #333; padding: 12px 25px; border: none; border-radius: 6px; font-size: 16px; font-weight: bold; text-decoration: none; display: inline-block; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
      ⬅️ Kembali ke Admin
    </a>
  </div>

</body>
</html>