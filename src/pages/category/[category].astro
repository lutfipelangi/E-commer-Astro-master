---
import Layout from "../../layouts/Layout.astro";
import CategoriesHeader from "../../components/categories/CategoriesHeader.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import { Icon } from "astro-icon/components";
import { products } from "../../data/products";
import { categories } from "../../data/home";

export async function getStaticPaths() {
    // Ambil semua kategori unik dari produk
    const uniqueCategories = [...new Set(products.map((p) => p.category))];

    return uniqueCategories.map((category) => {
        const categoryData = categories.find(
            (c) => c.name.toLowerCase() === category.toLowerCase(),
        );
        const categorySlug = category.toLowerCase();
        return {
            params: { category: categorySlug },
            props: {
                categoryName: category,
                categoryProducts: products.filter(
                    (p) => p.category === category,
                ),
                image: categoryData?.image,
            },
        };
    });
}

const { categoryName, categoryProducts, image } = Astro.props;

// Ambil parameter URL untuk filter
const url = new URL(Astro.request.url);
const subParam = url.searchParams.get("sub"); // contoh: blangko-softcover
const brandParam = url.searchParams.get("brand"); // contoh: Raffa

// Format Rupiah
const formatRp = (angka) => {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);
};

// Ambil daftar unik Subkategori dan Brand dari kategori ini saja
const availableSubs = [...new Set(categoryProducts.map(p => p.subcategory).filter(Boolean))];
const availableBrands = [...new Set(categoryProducts.map(p => p.brand).filter(Boolean))];

const breadcrumbItems = [{ label: "Home", href: "/" }, { label: categoryName }];
---

<Layout title={`${categoryName} | Kios Pelangi`}>
    <CategoriesHeader title={categoryName} image={image} />

    <div class="bg-gray-50 min-h-screen pb-20 pt-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div id="breadcrumbs-container" class="mb-6">
                <Breadcrumbs items={breadcrumbItems} />
            </div>

            <div class="flex flex-col md:flex-row gap-8">
                
                <!-- ========================================== -->
                <!-- SIDEBAR FILTER (KIRI)                      -->
                <!-- ========================================== -->
                <div class="w-full md:w-64 flex-shrink-0">
                    <div class="bg-white p-5 rounded-xl border border-gray-200 border-l-4 border-l-[#233876] shadow-sm sticky top-24">
                        
                        <!-- Filter Jenis Cover -->
                        <div class="mb-8">
                            <h3 class="font-bold text-gray-900 mb-3 border-b border-gray-100 pb-2 flex items-center gap-2">
                                <Icon name="lucide:layout" class="w-4 h-4 text-[#233876]" /> Jenis Cover
                            </h3>
                            <ul class="space-y-1">
                                <li>
                                    <a href={`/category/${categoryName.toLowerCase()}`} 
                                       class={`block px-3 py-2 rounded-lg text-sm transition-colors ${!subParam ? 'bg-blue-50 text-[#233876] font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>
                                       Semua Cover
                                    </a>
                                </li>
                                {availableSubs.map(sub => (
                                    <li>
                                        <a href={`/category/${categoryName.toLowerCase()}?sub=${sub}`} 
                                           class={`block px-3 py-2 rounded-lg text-sm capitalize transition-colors ${subParam === sub ? 'bg-blue-50 text-[#233876] font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>
                                           {sub.replace('blangko-', '').replace('-', ' ')}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>

                        <!-- Filter Merek (Hanya muncul jika ada merek) -->
                        {availableBrands.length > 0 && (
                            <div>
                                <h3 class="font-bold text-gray-900 mb-3 border-b border-gray-100 pb-2 flex items-center gap-2">
                                    <Icon name="lucide:tag" class="w-4 h-4 text-[#233876]" /> Merek
                                </h3>
                                <ul class="space-y-1">
                                    <li>
                                        <a href={`/category/${categoryName.toLowerCase()}${subParam ? `?sub=${subParam}` : ''}`} 
                                           class={`block px-3 py-2 rounded-lg text-sm transition-colors ${!brandParam ? 'bg-blue-50 text-[#233876] font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>
                                           Semua Merek
                                        </a>
                                    </li>
                                    {availableBrands.map(brand => (
                                        <li>
                                            <a href={`/category/${categoryName.toLowerCase()}?brand=${brand}${subParam ? `&sub=${subParam}` : ''}`} 
                                               class={`block px-3 py-2 rounded-lg text-sm transition-colors ${brandParam === brand ? 'bg-blue-50 text-[#233876] font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>
                                               {brand} Series
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}

                    </div>
                </div>

                <!-- ========================================== -->
                <!-- GRID PRODUK (KANAN)                        -->
                <!-- ========================================== -->
                <div class="flex-1">
                    <div class="mb-4 text-sm text-gray-500 bg-white p-3 rounded-lg border border-gray-200">
                        Menampilkan <strong id="visible-count">{categoryProducts.length}</strong> produk.
                    </div>

                    <div id="products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 animate-fade-in">
                        {categoryProducts.map((product) => (
                            <div class="product-item transition-all duration-300" 
                                 data-subcategory={product.subcategory?.toLowerCase() || ""}
                                 data-brand={product.brand?.toLowerCase() || ""}>
                                
                                <a href={`/product/${product.slug}`} class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-all duration-300 flex flex-col h-full">
                                    <div class="relative aspect-square bg-gray-100 overflow-hidden">
                                        <img 
                                            src={product.images[0]} 
                                            alt={product.title} 
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                                            onerror="this.src='https://placehold.co/400x400?text=No+Image'"
                                        />
                                    </div>
                                    <div class="p-3 sm:p-4 flex flex-col flex-grow">
                                        <span class="text-[10px] font-bold text-[#233876] bg-blue-50 w-fit px-2 py-0.5 rounded mb-2">
                                            {product.brand || 'Custom'}
                                        </span>
                                        <h3 class="text-sm font-bold text-gray-900 line-clamp-2 group-hover:text-[#233876] mb-3">
                                            {product.title}
                                        </h3>
                                        <div class="mt-auto pt-3 border-t border-gray-100">
                                            <span class="text-sm font-bold text-[#233876]">{formatRp(product.price)}</span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        ))}
                    </div>

                    <!-- Pesan Jika Produk Kosong -->
                    <div id="no-products-msg" class="hidden text-center py-24 bg-white rounded-2xl border-2 border-dashed border-gray-200 mt-6">
                        <p class="text-gray-400 font-bold uppercase tracking-widest">
                            Tidak ada produk untuk filter ini
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</Layout>

<script>
    function filterProducts() {
        const urlParams = new URLSearchParams(window.location.search);
        const subCategory = urlParams.get("sub")?.toLowerCase();
        const brand = urlParams.get("brand")?.toLowerCase();

        const products = document.querySelectorAll(".product-item");
        const noProductsMsg = document.getElementById("no-products-msg");
        const visibleCountEl = document.getElementById("visible-count");
        let visibleCount = 0;

        products.forEach((el) => {
            const item = el as HTMLElement;
            const itemSub = item.dataset.subcategory;
            const itemBrand = item.dataset.brand;

            let matchSub = true;
            let matchBrand = true;

            if (subCategory) {
                matchSub = itemSub === subCategory;
            }
            if (brand) {
                matchBrand = itemBrand === brand;
            }

            if (matchSub && matchBrand) {
                item.classList.remove("hidden");
                visibleCount++;
            } else {
                item.classList.add("hidden");
            }
        });

        // Update jumlah produk
        if (visibleCountEl) {
            visibleCountEl.innerText = visibleCount.toString();
        }

        // Tampilkan pesan kosong jika tidak ada yang cocok
        if (visibleCount === 0) {
            noProductsMsg?.classList.remove("hidden");
        } else {
            noProductsMsg?.classList.add("hidden");
        }
    }

    // Jalankan saat halaman dimuat
    filterProducts();

    // Jalankan saat navigasi (jika menggunakan View Transitions)
    document.addEventListener("astro:page-load", filterProducts);
</script>

<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fadeIn 0.6s ease-out forwards;
    }
</style>