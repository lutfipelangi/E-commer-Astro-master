---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Login - Kios Pelangi">
  <div class="min-h-screen bg-white flex flex-col items-center justify-center p-4">
    
    <!-- Logo -->
    <div class="mb-8 flex items-center gap-2">
      <div class="w-9 h-9 bg-[#233876] rounded-lg flex items-center justify-center">
        <Icon name="lucide:shopping-bag" class="w-5 h-5 text-white" />
      </div>
      <span class="text-2xl font-bold text-gray-900 tracking-tight">Kios Pelangi</span>
    </div>

    <!-- Kartu Login -->
    <div class="w-full max-w-[420px] bg-white border border-gray-200 rounded-[24px] p-8 shadow-sm">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Masuk ke Kios Pelangi</h1>
      <p class="text-sm text-gray-500 mb-6 leading-relaxed">
        Masuk dengan akun Google, atau dengan email dan kata sandi.
      </p>

      <!-- Tombol Google -->
      <button id="btn-google" class="w-full flex items-center justify-center gap-3 bg-white border border-gray-300 rounded-full py-3 px-4 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-all">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
        </svg>
        Masuk dengan Google
      </button>

      <!-- Garis Pemisah -->
      <div class="relative flex py-6 items-center">
        <div class="flex-grow border-t border-gray-200"></div>
        <span class="flex-shrink-0 mx-4 text-gray-400 text-xs">atau dengan email</span>
        <div class="flex-grow border-t border-gray-200"></div>
      </div>

      <!-- Form -->
      <form id="login-form" class="flex flex-col gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-800 mb-1.5">Email</label>
          <input type="email" id="email" placeholder="cth: budi@toko.id" class="w-full px-4 py-3 rounded-full border border-gray-300 text-sm focus:outline-none focus:border-[#233876]" required />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-800 mb-1.5">Kata Sandi</label>
          <input type="password" id="password" class="w-full px-4 py-3 rounded-full border border-gray-300 text-sm focus:outline-none focus:border-[#233876]" required />
        </div>
        <button type="submit" class="w-full bg-[#233876] hover:bg-[#1a2957] text-white font-bold rounded-full py-3.5 px-4 text-sm mt-2 transition-all shadow-md">
          Masuk
        </button>
      </form>
    </div>

    <!-- Tombol Kembali -->
    <a href="/" class="mt-8 text-sm text-gray-500 hover:text-gray-800 flex items-center gap-1 transition-colors">
      <span class="text-lg leading-none">&larr;</span> Kembali ke beranda
    </a>

  </div>
</Layout>

<!-- SCRIPT LOGIN -->
<script>
  import { supabase } from '../lib/supabase';

  // 1. Logika Google
  const btnGoogle = document.getElementById('btn-google');
  if (btnGoogle) {
    btnGoogle.addEventListener('click', async () => {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${window.location.origin}/` }
      });
      if (error) {
        console.error(error);
        alert('Gagal login Google: ' + error.message);
      }
    });
  }

  // 2. Logika Email/Password
  const loginForm = document.getElementById('login-form');
  if (loginForm) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault(); 
      
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;

      const { error } = await supabase.auth.signInWithPassword({
        email: email,
        password: password,
      });

      if (error) {
        console.error(error);
        alert('Gagal Login: ' + error.message); 
      } else {
        // PERUBAHAN DISINI: Alert dihapus, langsung pindah halaman
window.location.replace('/form-undangan');      }
    });
  }
</script>