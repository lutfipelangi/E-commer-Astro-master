---
import Layout from "../../layouts/Layout.astro";
import CardProduct from "../../components/products/CardProduct.astro";
import { products, getRelatedProducts } from "../../data/products";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
    return products.map((product) => ({
        params: { slug: product.slug },
        props: { product },
    }));
}

const { product } = Astro.props;
const relatedProducts = getRelatedProducts(product.category, product.slug);

// Fungsi Format Rupiah
const formatRp = (angka) => {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);
};

// Fallback jika gambar kosong
const mainImage = product.images[0] || "/images/placeholder.jpg";
---

<Layout title={`${product.name} | Kios Pelangi`}>
    <div class="bg-white min-h-screen pb-20 pt-8 font-sans">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Breadcrumbs -->
            <nav class="flex text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/" class="hover:text-[#233876]">Home</a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <Icon name="lucide:chevron-right" class="w-4 h-4 mx-1" />
                            <a href={`/category/${product.category}`} class="hover:text-[#233876] capitalize">{product.category}</a>
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <Icon name="lucide:chevron-right" class="w-4 h-4 mx-1" />
                            <span class="text-[#233876] font-semibold">{product.name}</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <!-- Product Details Section -->
            <div class="flex flex-col lg:flex-row gap-10 lg:gap-16">
                
                <!-- KIRI: GAMBAR PRODUK -->
                <div class="w-full lg:w-1/2 flex flex-col-reverse md:flex-row gap-4">
                    <!-- Thumbnail List -->
                    <div class="flex md:flex-col gap-3 overflow-x-auto md:overflow-y-auto md:max-h-[500px] no-scrollbar">
                        {product.images.map((img, index) => (
                            <img 
                                src={img} 
                                alt={`${product.name} - ${index + 1}`} 
                                class="w-20 h-20 object-cover border-2 border-transparent hover:border-[#233876] rounded-lg cursor-pointer transition-all bg-gray-50"
                            />
                        ))}
                    </div>
                    <!-- Main Image -->
                    <div class="flex-1 bg-gray-50 rounded-xl overflow-hidden border border-gray-200 flex items-center justify-center p-4">
                        <img 
                            src={mainImage} 
                            alt={product.name} 
                            class="w-full h-auto max-h-[600px] object-contain"
                        />
                    </div>
                </div>

                <!-- KANAN: INFO PRODUK & HARGA -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-xs font-bold tracking-widest text-[#233876] uppercase">{product.category} {product.subcategory ? `/ ${product.subcategory}` : ''}</span>
                        {product.badge && (
                            <span class="bg-rose-500 text-white text-[10px] font-bold px-2.5 py-1 rounded-sm shadow-sm">{product.badge}</span>
                        )}
                    </div>

                    <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4 leading-tight">{product.name}</h1>
                    
                    <div class="text-3xl font-bold text-[#233876] mb-6">
                        {formatRp(product.price)}
                        {product.category === 'undangan' && <span class="text-sm font-normal text-gray-500 ml-2">/ pcs</span>}
                    </div>

                    <!-- TABEL HARGA GROSIR -->
                    <div class="mb-8 w-full sm:w-3/4 border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-100 text-gray-700">
                                <tr>
                                    <th class="py-3 px-4 text-left border-b font-bold">Jumlah Pembelian</th>
                                    <th class="py-3 px-4 text-right border-b font-bold">Harga Satuan</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 bg-white">
                                <tr>
                                    <td class="py-2.5 px-4 text-gray-600">50 - 99 pcs</td>
                                    <td class="py-2.5 px-4 text-right text-gray-900 font-medium">{formatRp(product.price)}</td>
                                </tr>
                                <tr>
                                    <td class="py-2.5 px-4 text-gray-600">100 - 299 pcs</td>
                                    <td class="py-2.5 px-4 text-right text-gray-900 font-medium">{formatRp(product.price - 500)}</td>
                                </tr>
                                <tr>
                                    <td class="py-2.5 px-4 text-gray-600">300 - 499 pcs</td>
                                    <td class="py-2.5 px-4 text-right text-gray-900 font-medium">{formatRp(product.price - 1000)}</td>
                                </tr>
                                <tr>
                                    <td class="py-2.5 px-4 text-gray-600">&gt; 500 pcs</td>
                                    <td class="py-2.5 px-4 text-right text-green-600 font-bold">Hubungi Admin</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- TOMBOL AKSI (PESAN & WA) -->
                    <div class="flex flex-col sm:flex-row gap-4 mb-8">
                        <a href={`/form-undangan?model=${product.slug}`} class="flex-1 bg-[#233876] hover:bg-[#1a2957] text-white font-bold text-center py-4 px-6 rounded-lg transition-all shadow-lg flex items-center justify-center gap-2 transform hover:-translate-y-0.5">
                            <Icon name="lucide:shopping-bag" class="w-5 h-5" /> Pesan Sekarang
                        </a>
                        <a href={`https://wa.me/62816262734?text=Halo%20Admin,%20saya%20mau%20tanya%20model%20${product.name}`} target="_blank" class="flex-1 bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-center py-4 px-6 rounded-lg transition-all shadow-lg flex items-center justify-center gap-2 transform hover:-translate-y-0.5">
                            <Icon name="lucide:message-circle" class="w-5 h-5" /> Chat WhatsApp
                        </a>
                    </div>

                    <!-- Deskripsi Singkat -->
                    <div class="mb-6">
                        <h3 class="text-sm font-bold text-gray-900 mb-2 uppercase tracking-wide">Deskripsi Produk:</h3>
                        <p class="text-gray-600 leading-relaxed text-sm text-justify">
                            {product.description}
                        </p>
                    </div>
                </div>
            </div>

            <!-- BAGIAN BAWAH: SPESIFIKASI DETAIL -->
            <div class="mt-16 border-t border-gray-200 pt-10">
                <h2 class="text-2xl font-bold text-gray-900 mb-6">Spesifikasi & Detail:</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    
                    <div>
                        <ul class="space-y-4">
                            {product.specs?.map((spec) => (
                                <li class="flex items-start">
                                    <span class="text-[#233876] mr-3 mt-0.5"><Icon name="lucide:check-circle-2" class="w-5 h-5" /></span>
                                    <div>
                                        <span class="font-bold text-gray-800 block mb-0.5">{spec.label}</span>
                                        <span class="text-gray-600 text-sm">{spec.value}</span>
                                    </div>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="bg-blue-50 p-6 rounded-xl border border-blue-100 h-fit">
                        <h3 class="font-bold text-[#233876] mb-3 flex items-center gap-2">
                            <Icon name="lucide:info" class="w-5 h-5" /> Informasi Pemesanan
                        </h3>
                        <ul class="text-sm text-gray-700 space-y-2.5 list-disc pl-5">
                            <li>Harga di atas belum termasuk biaya pengiriman.</li>
                            <li>Minimal pemesanan (MOQ) disesuaikan dengan jenis produk.</li>
                            <li>Waktu pengerjaan normal 5-7 hari kerja setelah desain di-ACC dan DP masuk.</li>
                            <li>Untuk request desain khusus (Custom), silakan klik tombol <strong>Chat WhatsApp</strong>.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Related Products Section (Produk Terkait) -->
            {relatedProducts.length > 0 && (
                <section class="mt-24 pt-10 border-t border-gray-200">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-2xl font-bold text-gray-900">
                            Model Lainnya
                        </h2>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        {relatedProducts.map((relProduct) => (
                            <CardProduct
                                title={relProduct.name}
                                price={relProduct.price}
                                images={relProduct.images}
                                stock={relProduct.stock}
                                slug={relProduct.slug}
                            />
                        ))}
                    </div>
                </section>
            )}
        </div>
    </div>
</Layout>