---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { products } from "../../data/products";

// Ambil parameter URL
const url = new URL(Astro.request.url);
const currentCategory = Astro.params.slug; // contoh: "blangko"
const subParam = url.searchParams.get("sub"); // contoh: "blangko-softcover"
const brandParam = url.searchParams.get("brand"); // contoh: "Raffa"

// 1. Ambil semua produk di kategori ini (sebelum difilter)
let baseProducts = products.filter(p => p.category === currentCategory);

// 2. Ambil daftar unik Jenis Cover (Subkategori)
const availableSubs = [...new Set(baseProducts.map(p => p.subcategory).filter(Boolean))];

// 3. Ambil daftar unik Merek
const availableBrands = [...new Set(baseProducts.map(p => p.brand).filter(Boolean))];

// 4. Filter Produk berdasarkan URL
let filteredProducts = baseProducts;
if (subParam) {
    filteredProducts = filteredProducts.filter(p => p.subcategory === subParam);
}
if (brandParam) {
    filteredProducts = filteredProducts.filter(p => p.brand === brandParam);
}

const formatRp = (angka) => {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);
};

const pageTitle = currentCategory.charAt(0).toUpperCase() + currentCategory.slice(1);
---

<Layout title={`Katalog ${pageTitle} | Kios Pelangi`}>
    <div class="bg-gray-50 min-h-screen pb-20">
        
        <!-- Header -->
        <div class="bg-white border-b border-gray-200 py-8 mb-8">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 capitalize">Katalog {pageTitle}</h1>
                <p class="text-sm text-gray-500 mt-2">Gunakan filter di samping untuk menemukan desain yang Anda cari.</p>
            </div>
        </div>

        <!-- Container Utama (Kiri: Sidebar, Kanan: Grid) -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row gap-8">
            
            <!-- ========================================== -->
            <!-- SIDEBAR FILTER (KIRI)                      -->
            <!-- ========================================== -->
            <div class="w-full md:w-64 flex-shrink-0">
                <div class="bg-white p-5 rounded-xl border border-gray-200 border-l-4 border-l-[#233876] shadow-sm sticky top-24">
                    
                    <!-- Filter Jenis Cover -->
                    <div class="mb-8">
                        <h3 class="font-bold text-gray-900 mb-3 border-b border-gray-100 pb-2 flex items-center gap-2">
                            <Icon name="lucide:layout" class="w-4 h-4 text-[#233876]" /> Jenis Cover
                        </h3>
                        <ul class="space-y-1">
                            <li>
                                <a href={`/category/${currentCategory}${brandParam ? `?brand=${brandParam}` : ''}`} 
                                   class={`block px-3 py-2 rounded-lg text-sm transition-colors ${!subParam ? 'bg-blue-50 text-[#233876] font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>
                                   Semua Cover
                                </a>
                            </li>
                            {availableSubs.map(sub => (
                                <li>
                                    <a href={`/category/${currentCategory}?sub=${sub}${brandParam ? `&brand=${brandParam}` : ''}`} 
                                       class={`block px-3 py-2 rounded-lg text-sm capitalize transition-colors ${subParam === sub ? 'bg-blue-50 text-[#233876] font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>
                                       {sub.replace('blangko-', '').replace('-', ' ')}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <!-- Filter Merek -->
                    <div>
                        <h3 class="font-bold text-gray-900 mb-3 border-b border-gray-100 pb-2 flex items-center gap-2">
                            <Icon name="lucide:tag" class="w-4 h-4 text-[#233876]" /> Merek
                        </h3>
                        <ul class="space-y-1">
                            <li>
                                <a href={`/category/${currentCategory}${subParam ? `?sub=${subParam}` : ''}`} 
                                   class={`block px-3 py-2 rounded-lg text-sm transition-colors ${!brandParam ? 'bg-blue-50 text-[#233876] font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>
                                   Semua Merek
                                </a>
                            </li>
                            {availableBrands.map(brand => (
                                <li>
                                    <a href={`/category/${currentCategory}?brand=${brand}${subParam ? `&sub=${subParam}` : ''}`} 
                                       class={`block px-3 py-2 rounded-lg text-sm transition-colors ${brandParam === brand ? 'bg-blue-50 text-[#233876] font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>
                                       {brand} Series
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>

                </div>
            </div>

            <!-- ========================================== -->
            <!-- GRID PRODUK (KANAN)                        -->
            <!-- ========================================== -->
            <div class="flex-1">
                
                <div class="mb-4 text-sm text-gray-500 bg-white p-3 rounded-lg border border-gray-200">
                    Menampilkan <strong>{filteredProducts.length}</strong> produk.
                </div>

                {filteredProducts.length === 0 ? (
                    <div class="text-center py-20 bg-white rounded-xl border border-dashed border-gray-300">
                        <Icon name="lucide:package-search" class="w-12 h-12 text-gray-400 mx-auto mb-4" />
                        <p class="text-gray-500">Belum ada produk untuk filter ini.</p>
                    </div>
                ) : (
                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                        {filteredProducts.map((product) => (
                            <!-- DESAIN KARTU BARU (TANPA $ & TANPA IN STOCK) -->
                            <a href={`/product/${product.slug}`} class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-all duration-300 flex flex-col">
                                
                                <div class="relative aspect-square bg-gray-100 overflow-hidden">
                                    <img 
                                        src={product.images[0]} 
                                        alt={product.name} 
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                                        onerror="this.src='https://placehold.co/400x400?text=No+Image'"
                                    />
                                </div>

                                <div class="p-3 sm:p-4 flex flex-col flex-grow">
                                    <!-- Badge Merek (Raffa, Mira, dll) -->
                                    <span class="text-[10px] font-bold text-[#233876] bg-blue-50 w-fit px-2 py-0.5 rounded mb-2">
                                        {product.brand || 'Custom'}
                                    </span>
                                    
                                    <h3 class="text-sm font-bold text-gray-900 line-clamp-2 group-hover:text-[#233876] mb-3">
                                        {product.name}
                                    </h3>
                                    
                                    <!-- Harga Rupiah -->
                                    <div class="mt-auto pt-3 border-t border-gray-100">
                                        <span class="text-sm font-bold text-[#233876]">{formatRp(product.price)}</span>
                                    </div>
                                </div>
                            </a>
                        ))}
                    </div>
                )}
            </div>

        </div>
    </div>
</Layout>