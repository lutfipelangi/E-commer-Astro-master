---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Dashboard - Kios Pelangi">
    <div class="min-h-screen bg-base-200 py-12">
        <div class="max-w-3xl mx-auto px-4">
            
            <div class="flex justify-between items-center mb-8 bg-white p-6 rounded-xl shadow-sm">
                <div>
                    <h1 class="text-2xl font-bold text-[#233876]">Dashboard Klien</h1>
                    <p class="text-gray-500 text-sm" id="user-email">Memuat email...</p>
                </div>
                <button id="logout-btn" class="btn btn-outline btn-error btn-sm">Logout</button>
            </div>

            <div class="bg-white p-8 rounded-xl shadow-sm">
                <h2 class="text-xl font-bold mb-6 text-gray-800">Form Data Undangan</h2>
                <form id="undangan-form" class="flex flex-col gap-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="label"><span class="label-text">Nama Mempelai Pria</span></label>
                            <input type="text" id="pria" class="input input-bordered w-full" required />
                        </div>
                        <div>
                            <label class="label"><span class="label-text">Nama Mempelai Wanita</span></label>
                            <input type="text" id="wanita" class="input input-bordered w-full" required />
                        </div>
                    </div>
                    <div>
                        <label class="label"><span class="label-text">Tanggal Acara</span></label>
                        <input type="date" id="tanggal" class="input input-bordered w-full" required />
                    </div>
                    <div>
                        <label class="label"><span class="label-text">Lokasi Acara</span></label>
                        <textarea id="lokasi" class="textarea textarea-bordered w-full" rows="3" required></textarea>
                    </div>
                    <button type="submit" class="btn bg-[#233876] hover:bg-[#1a2957] text-white mt-4">Simpan Data Undangan</button>
                </form>
                <div id="message" class="mt-4 text-center font-medium"></div>
            </div>
        </div>
    </div>
</Layout>

<script>
    // 1. Cek apakah user sudah login lokal
    if (localStorage.getItem('isLoggedIn') !== 'true') {
        window.location.href = "/login";
    } else {
        const email = localStorage.getItem('userEmail');
        const emailDisplay = document.getElementById('user-email');
        if(emailDisplay && email) emailDisplay.textContent = email;
    }

    // 2. Tombol Logout
    document.getElementById('logout-btn')?.addEventListener('click', () => {
        localStorage.removeItem('isLoggedIn');
        localStorage.removeItem('userEmail');
        window.location.href = "/login";
    });

    // 3. Simpan Form (Simulasi)
    document.getElementById('undangan-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const message = document.getElementById('message');
        if(message) {
            message.textContent = "Data berhasil disimpan!";
            message.className = "mt-4 text-center font-medium text-green-500";
        }
        (e.target as HTMLFormElement).reset();
    });
</script>