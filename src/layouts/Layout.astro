---
import "../styles/global.css";
import Navbar from "../components/navbar/NavBar.astro";
import AnnouncementBar from "../components/ui/AnnouncementBar.astro";
import Footer from "../components/footer/Footer.astro";
import ToasterComponent from "../components/ui/ToasterComponent";
import CartDrawer from "../components/cart/CartDrawer.astro";
import SEO from "../components/seo.astro";
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<script is:inline>
    if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.setAttribute('data-theme', 'dark');
    } else {
        document.documentElement.setAttribute('data-theme', 'light');
    }
</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<SEO 
  title="PERCETAKAN | UNDANGAN & SOUVENIR" 
  description="Percetakan undangan & Souvenir murah di surabaya"
/>
	</head>
	<body class="bg-base-200 min-h-screen">
		<AnnouncementBar />
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
		<CartDrawer />
		<ToasterComponent client:load />
		<!-- Tombol Back to Top -->
<button id="backToTop" class="fixed bottom-8 right-8 z-50 bg-sky-500 hover:bg-sky-600 text-white p-3 rounded-md shadow-lg transition-all duration-300 opacity-0 pointer-events-none">
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="m18 15-6-6-6 6"/>
  </svg>
</button>

<script>
  const backToTopBtn = document.getElementById("backToTop");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 300) {
      backToTopBtn?.classList.remove("opacity-0", "pointer-events-none");
      backToTopBtn?.classList.add("opacity-100", "pointer-events-auto");
    } else {
      backToTopBtn?.classList.add("opacity-0", "pointer-events-none");
      backToTopBtn?.classList.remove("opacity-100", "pointer-events-auto");
    }
  });

  backToTopBtn?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  });
</script>

<!-- Custom Cursor (Lingkaran & Titik) -->
<div id="cursor-ring" class="fixed top-0 left-0 w-12 h-12 border-2 border-primary/50 rounded-full pointer-events-none z-[9999] -translate-x-1/2 -translate-y-1/2 transition-opacity duration-300 opacity-0 hidden md:block"></div>
<div id="cursor-dot" class="fixed top-0 left-0 w-2.5 h-2.5 bg-black dark:bg-white rounded-full pointer-events-none z-[9999] -translate-x-1/2 -translate-y-1/2 transition-opacity duration-300 opacity-0 hidden md:block"></div>

<script>
  const ring = document.getElementById('cursor-ring');
  const dot = document.getElementById('cursor-dot');

  let mouseX = 0, mouseY = 0;
  let ringX = 0, ringY = 0;

  // Pantau pergerakan mouse
  window.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    
    // Munculkan kursor saat mouse mulai bergerak
    if (ring && dot) {
      ring.style.opacity = '1';
      dot.style.opacity = '1';
    }

    // Titik hitam menempel persis di mouse
    if (dot) {
      dot.style.transform = `translate(${mouseX}px, ${mouseY}px) translate(-50%, -50%)`;
    }
  });

  // Fungsi animasi agar lingkaran luar bergerak lebih halus (Lerp)
  function animateRing() {
    if (ring) {
      // Angka 0.15 menentukan kecepatan lingkaran menyusul (semakin kecil semakin lambat/mulus)
      ringX += (mouseX - ringX) * 0.15;
      ringY += (mouseY - ringY) * 0.15;
      
      ring.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%, -50%)`;
    }
    requestAnimationFrame(animateRing);
  }
  
  // Jalankan animasi
  animateRing();

  // Sembunyikan kursor jika mouse keluar dari jendela browser
  document.addEventListener('mouseleave', () => {
    if (ring && dot) {
      ring.style.opacity = '0';
      dot.style.opacity = '0';
    }
  });
</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
	}
</style>
