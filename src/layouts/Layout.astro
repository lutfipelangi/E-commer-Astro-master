---
import "../styles/global.css";
import Navbar from "../components/navbar/NavBar.astro";
import AnnouncementBar from "../components/ui/AnnouncementBar.astro";
import Footer from "../components/footer/Footer.astro";
import SEO from "../components/seo.astro";
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
    <meta name="robots" content="noindex, nofollow">
		<script is:inline>
        if (localStorage.getItem('color-theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        } else {
            document.documentElement.setAttribute('data-theme', 'light');
        }</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<SEO 
      title="PERCETAKAN | UNDANGAN & SOUVENIR" 
      description="Percetakan undangan & Souvenir murah di surabaya"
    />
	</head>
	
	<body class="bg-base-200 min-h-screen">
		<AnnouncementBar />
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />

		<!-- ================= FLOATING WHATSAPP WIDGET ================= -->
		<div id="wa-widget-container" class="fixed bottom-6 right-20 z-50 flex flex-col items-end">
			
			<!-- Popup Card (DISEMBUNYIKAN DULU DENGAN CLASS 'hidden') -->
			<div id="wa-popup" class="hidden mb-4 w-80 bg-white rounded-xl shadow-2xl overflow-hidden border border-gray-100 transition-all duration-300 transform">
				<!-- Header Hijau -->
				<div class="bg-[#25D366] p-4 text-white relative">
					<button id="close-wa-popup" class="absolute top-2 right-2 text-white/80 hover:text-white cursor-pointer">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
					</button>
					<p class="text-sm font-medium leading-relaxed pr-6">Butuh bantuan atau ada pertanyaan? Mari berdiskusi bersama kami.</p>
				</div>
				
				<!-- Body Putih (Klik untuk ke WA) -->
				<div class="p-4 flex items-center gap-4 bg-gray-50 hover:bg-gray-100 transition-colors cursor-pointer" onclick="window.open('https://wa.me/62816262734?text=Halo%20Admin%20Kios%20Pelangi,%20saya%20ingin%20bertanya.', '_blank')">
					<!-- Ikon User + WA -->
					<div class="w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-sm border border-gray-200 shrink-0 relative">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#233876]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
						<div class="absolute -bottom-1 -right-1 bg-[#25D366] rounded-full p-1 border-2 border-white">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
						</div>
					</div>
					<!-- Teks CS -->
					<div>
						<p class="text-xs text-gray-500 font-medium">Customer Support</p>
						<p class="text-sm font-bold text-gray-800">CS - Kios Pelangi</p>
					</div>
				</div>
			</div>

			<!-- Tombol Kapsul "Chat Kami" -->
			<button id="toggle-wa-popup" class="bg-[#25D366] hover:bg-[#20bd5a] text-white px-5 py-3 rounded-full shadow-lg flex items-center gap-2 transition-all hover:-translate-y-1">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
				<span class="font-bold text-sm">Chat Kami</span>
			</button>
		</div>

		<!-- Tombol Back to Top -->
		<button id="backToTop" aria-label="Kembali ke atas" class="fixed bottom-6 right-6 z-50 bg-sky-500 hover:bg-sky-600 text-white p-3 rounded-full shadow-lg transition-all duration-300 opacity-0 pointer-events-none">
			<span class="sr-only">Kembali ke atas</span>
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true">
				<path d="m18 15-6-6-6 6"/>
			</svg>
		</button>

		<!-- Custom Cursor -->
		<div id="cursor-ring" class="fixed top-0 left-0 w-12 h-12 border-2 border-primary/50 rounded-full pointer-events-none z-[9999] -translate-x-1/2 -translate-y-1/2 transition-opacity duration-300 opacity-0 hidden md:block"></div>
		<div id="cursor-dot" class="fixed top-0 left-0 w-2.5 h-2.5 bg-black dark:bg-white rounded-full pointer-events-none z-[9999] -translate-x-1/2 -translate-y-1/2 transition-opacity duration-300 opacity-0 hidden md:block"></div>

		<!-- ================= SCRIPTS ================= -->
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				// --- LOGIKA WA WIDGET (BUKA/TUTUP) ---
				const toggleBtn = document.getElementById('toggle-wa-popup');
				const closeBtn = document.getElementById('close-wa-popup');
				const popup = document.getElementById('wa-popup');

				if(toggleBtn && popup) {
					toggleBtn.addEventListener('click', () => {
						if (popup.classList.contains('hidden')) {
							popup.classList.remove('hidden');
						} else {
							popup.classList.add('hidden');
						}
					});

					closeBtn.addEventListener('click', () => {
						popup.classList.add('hidden');
					});
				}

				// --- LOGIKA BACK TO TOP ---
				const backToTopBtn = document.getElementById("backToTop");
				if (backToTopBtn) {
					window.addEventListener("scroll", () => {
						if (window.scrollY > 300) {
							backToTopBtn.classList.remove("opacity-0", "pointer-events-none");
							backToTopBtn.classList.add("opacity-100", "pointer-events-auto");
						} else {
							backToTopBtn.classList.add("opacity-0", "pointer-events-none");
							backToTopBtn.classList.remove("opacity-100", "pointer-events-auto");
						}
					});

					backToTopBtn.addEventListener("click", () => {
						window.scrollTo({
							top: 0,
							behavior: "smooth"
						});
					});
				}

				// --- LOGIKA CUSTOM CURSOR ---
				const ring = document.getElementById('cursor-ring');
				const dot = document.getElementById('cursor-dot');

				let mouseX = 0, mouseY = 0;
				let ringX = 0, ringY = 0;

				window.addEventListener('mousemove', (e) => {
					mouseX = e.clientX;
					mouseY = e.clientY;
					
					if (ring && dot) {
						ring.style.opacity = '1';
						dot.style.opacity = '1';
					}

					if (dot) {
						dot.style.transform = `translate(${mouseX}px, ${mouseY}px) translate(-50%, -50%)`;
					}
				});

				function animateRing() {
					if (ring) {
						ringX += (mouseX - ringX) * 0.15;
						ringY += (mouseY - ringY) * 0.15;
						ring.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%, -50%)`;
					}
					requestAnimationFrame(animateRing);
				}
				
				animateRing();

				document.addEventListener('mouseleave', () => {
					if (ring && dot) {
						ring.style.opacity = '0';
						dot.style.opacity = '0';
					}
				});
			});
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
	}
</style>